				class:
					"bg-neutral-200/60 dark:bg-neutral-700/60 text-neutral-700 dark:text-neutral-300",
			},
		],
		coupon: "AMM",
		couponLabel: "8折: AMM",
		officialUrl: "https://sahude.gsyvipaff.com/#/?code=keqgvT5Y",
		reviewUrl: "/posts/guangshuyun-review/",
	},
	{
		id: "weifeng",
		name: "微风网络",
		isFeatured: false,
		price: "折合 ¥7.0/月",
		tags: [
			{
				text: "轻量高稳",
				class: "bg-sky-500/15 text-sky-600 dark:text-sky-400 font-medium",
			},
			{
				text: "50GB/月",
				class:
					"bg-neutral-200/50 dark:bg-neutral-700/50 text-neutral-600 dark:text-neutral-300",
			},
			{
				text: "IEPL专线",
				class:
					"bg-neutral-200/50 dark:bg-neutral-700/50 text-neutral-600 dark:text-neutral-300",
			},
		],
		coupon: "wf888",
		couponLabel: "券: wf888",
		officialUrl: "https://guangs.weifengaff.top/#/?code=VjRz832G",
		reviewUrl: "/posts/brand-weifeng-review/",
	},
	{
		id: "feimaoyun",
		name: "飞猫云",
		isFeatured: false,
		price: "折合 ¥7.0/月",
		tags: [
			{
				text: "入门首选",
				class:
					"bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 font-medium",
			},
			{
				text: "50GB/月",
				class:
					"bg-neutral-200/50 dark:bg-neutral-700/50 text-neutral-600 dark:text-neutral-300",
			},
			{
				text: "便宜省心",
				class:
					"bg-neutral-200/50 dark:bg-neutral-700/50 text-neutral-600 dark:text-neutral-300",
			},
		],
		coupon: "feimao",
		couponLabel: "券: feimao",
		officialUrl: "https://guangs.feimaoyunaff.top/#/?code=Kx2P4q",
		reviewUrl: "/posts/brand-feimaoyun-review/",
	},
	{
		id: "xingdaomeng",
		name: "星岛梦",
		isFeatured: false,
		price: "折合 ¥8.0/月",
		tags: [
			{
				text: "不限时神机",
				class:
					"bg-purple-500/15 text-purple-600 dark:text-purple-400 font-medium",
			},
			{
				text: "永不清零",
				class:
					"bg-neutral-200/50 dark:bg-neutral-700/50 text-neutral-600 dark:text-neutral-300",
			},
			{
				text: "容灾备用",
				class:
					"bg-neutral-200/50 dark:bg-neutral-700/50 text-neutral-600 dark:text-neutral-300",
			},
		],
		coupon: "nmw888",
		couponLabel: "9折: nmw888",
		officialUrl: "https://guangs.xingdaomeng.com/#/?code=1TynBYnR",
		reviewUrl: "/posts/brand-xingdaomeng-review/",
	},
	{
		id: "weitu",
		name: "唯兔云",
		isFeatured: false,
		price: "¥14.9/月",
