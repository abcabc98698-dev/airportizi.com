---

<WidgetLayout
  name="商业机场合作区"
  showTitle={showTitle}
  id="commercial-partners"
  class={className}
  style={style}
>
  <span
    slot="title-icon"
    class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-1 shadow-xs"
  >
    <Icon name="material-symbols:verified-rounded" class="text-xs shrink-0" />
    <span class="whitespace-nowrap">官方精选</span>
  </span>

  <div class="flex flex-col gap-2.5">
    {partners.map((partner) => (
      <div
        class:list={[
          "rounded-xl p-2.5 transition-all duration-200 group",
          partner.isFeatured
            ? "border border-(--primary)/50 bg-gradient-to-br from-(--primary)/10 via-(--primary)/5 to-transparent shadow-xs hover:border-(--primary) hover:shadow-md"
            : "border border-neutral-200/80 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-800/30 hover:bg-neutral-50 dark:hover:bg-neutral-800/60 hover:border-(--primary)/40"
        ]}
      >
        {/* 第一行：品牌名称 + 价格（左右分布，严格禁止竖向折行） */}
        <div class="flex items-center justify-between gap-2">
          <span class="font-bold text-base text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors whitespace-nowrap shrink-0">
            {partner.name}
          </span>
          <span
            class:list={[
              "text-xs font-bold px-2 py-0.5 rounded-md shrink-0 whitespace-nowrap",
              partner.isFeatured
                ? "text-amber-600 dark:text-amber-400 bg-amber-500/10 border border-amber-500/25"
                : "text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-700/60"
            ]}
          >
            {partner.price}
          </span>
        </div>

        {/* 第二行：核心标签矩阵（自然流式排版，完美适配紧凑侧栏） */}
        <div class="flex flex-wrap gap-1 mt-1.5 mb-2">
          {partner.tags.map((tag) => (
            <span class:list={["text-[10px] px-1.5 py-0.5 rounded shrink-0 whitespace-nowrap", tag.class]}>
              {tag.text}
            </span>
          ))}
        </div>

        {/* 第三行：优惠码一键复制 + 评测详情 + 直达通道 */}
        <div
          class:list={[
            "flex items-center justify-between gap-1.5 pt-2 border-t",
            partner.isFeatured
              ? "border-(--primary)/20"
              : "border-neutral-200/70 dark:border-neutral-800"
          ]}
        >
          <button
            type="button"
            class="partner-copy-btn flex items-center gap-1 text-[11px] font-mono px-2 py-0.5 rounded bg-white/90 dark:bg-neutral-800 hover:bg-(--primary)/10 text-neutral-700 dark:text-neutral-200 border border-neutral-200/80 dark:border-neutral-700 transition-colors cursor-pointer shrink-0"
            data-coupon={partner.coupon}
            title="点击复制优惠码"
          >
            <Icon name="material-symbols:content-copy-outline-rounded" class="text-xs text-(--primary) shrink-0" />
            <span class="coupon-text whitespace-nowrap">{partner.couponLabel}</span>
          </button>

          <div class="flex items-center gap-1.5 shrink-0">
            {partner.reviewUrl && (
              <a
                href={partner.reviewUrl}
                class="text-xs text-neutral-500 hover:text-(--primary) hover:underline transition-colors px-1 py-0.5 whitespace-nowrap"
              >
                评测
              </a>
            )}
            <a
              href={partner.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "text-xs font-semibold px-2.5 py-1 rounded-lg flex items-center gap-1 active:scale-95 transition-all shadow-xs shrink-0 whitespace-nowrap",
                partner.isFeatured
                  ? "btn-primary"
                  : "btn-regular hover:text-(--primary)"
              ]}
            >
              <span>{partner.isFeatured ? "直达官网" : "直达"}</span>
              <Icon name="fa7-solid:arrow-up-right-from-square" class="text-[9px] shrink-0" />
            </a>
          </div>
        </div>
      </div>
    ))}

    {/* 卡片底栏：全局导航指引 */}
    <div class="pt-1 pb-0.5 text-center">
      <a
        href="/posts/comparison-airports-pricing-lines/"
        class="inline-flex items-center gap-1 text-[11px] text-neutral-500 dark:text-neutral-400 hover:text-(--primary) transition-colors font-medium group whitespace-nowrap"
      >
        <span>查看更多机场横评与榜单</span>
        <Icon name="material-symbols:arrow-forward-rounded" class="text-xs group-hover:translate-x-0.5 transition-transform shrink-0" />
      </a>
    </div>
  </div>
</WidgetLayout>

<!-- 优惠码一键点击复制交互脚本 -->
<script is:inline>
  function initPartnerCopyButtons() {
    const buttons = document.querySelectorAll(".partner-copy-btn");
    buttons.forEach((btn) => {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = "true";

      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        const coupon = btn.dataset.coupon;
        if (!coupon) return;

        const textSpan = btn.querySelector(".coupon-text");
        const originalText = textSpan ? textSpan.textContent : "";

        try {
          await navigator.clipboard.writeText(coupon);
          if (textSpan) {
            textSpan.textContent = "已复制 ✓";
            btn.classList.add("text-emerald-600", "dark:text-emerald-400", "border-emerald-500/50");
            setTimeout(() => {
              textSpan.textContent = originalText;
              btn.classList.remove("text-emerald-600", "dark:text-emerald-400", "border-emerald-500/50");
            }, 1800);
          }
        } catch (err) {
          console.error("复制优惠码失败: ", err);
        }
      });
    });
  }

  // 页面初次加载时初始化
  initPartnerCopyButtons();

  // Swup 页面切换完成后重新初始化
  if (!window.__partnerCopyInit) {
    window.__partnerCopyInit = true;
    document.addEventListener("swup:contentReplaced", () => {
      setTimeout(initPartnerCopyButtons, 100);
    });
  }
</script>
