---
import CategoryLanding from "@/components/seo/CategoryLanding.astro";
import { getSortedPosts } from "@/utils/content-utils";

const allPosts = await getSortedPosts();
// 筛选优惠码、便宜、性价比文章
const freePosts = allPosts.filter((p) => {
	const tags = p.data.tags || [];
	return tags.some((t) =>
		[
			"优惠码",
			"便宜机场",
			"性价比机场",
			"7元机场",
			"8元机场",
			"10元以下机场",
			"15元机场",
			"小流量机场",
		].includes(t),
	);
});

const subLinks = [
	{
		name: "光速云 8折优惠码 AMM",
		url: "/posts/guangshuyun-review/",
		icon: "material-symbols:loyalty-rounded",
		badge: "折合约7.5元/月",
	},
	{
		name: "飞猫云 8折码 flycat888",
		url: "/posts/brand-feimaoyun-review/",
