];

const faqs = [
	{
		question: "网上流传的‘完全免费节点’真的能长期使用吗？",
		answer:
			"天下没有免费的午餐。绝大多数公开的免费节点不仅速度慢、频繁断连，更存在严重的中间人明文嗅探和日志窃取风险。建议使用大牌机场的低成本小流量套餐或输入专属优惠码购买月付，既经济实惠又安全可靠。",
	},
