---
import CategoryLanding from "@/components/seo/CategoryLanding.astro";
import { getSortedPosts } from "@/utils/content-utils";

const allPosts = await getSortedPosts();
// 筛选机场推荐、排行榜相关文章
const jichangPosts = allPosts.filter((p) => {
	const tags = p.data.tags || [];
	const cat = p.data.category || "";
	return (
		cat.includes("机场推荐") ||
		cat.includes("机场排行榜") ||
		tags.some((t) =>
			[
				"机场推荐",
				"机场排行榜",
				"综合排行",
				"稳定性排行",
				"性价比排行",
				"价格排行",
				"稳定机场",
				"主推机场",
			].includes(t),
		)
	);
});

const subLinks = [
	{
		name: "2026 精选机场推荐",
		url: "/posts/recommend-2026-best-airports/",
		icon: "material-symbols:star-rounded",
		badge: "年度推荐",
	},
	{
		name: "全景综合排行榜",
		url: "/posts/ranking-overall-performance-stability/",
		icon: "material-symbols:leaderboard-rounded",
		badge: "权威榜单",
	},
	{
		name: "光速云 (TOP 1 主推)",
		url: "/posts/guangshuyun-review/",
		icon: "material-symbols:bolt-rounded",
		badge: "TOP 1 8折码",
	},
	{
		name: "微风网络 (TOP 2)",
		url: "/posts/brand-weifeng-review/",
		icon: "material-symbols:air-rounded",
		badge: "TOP 2",
	},
	{
		name: "飞猫云 (TOP 3)",
		url: "/posts/brand-feimaoyun-review/",
		icon: "material-symbols:pets-rounded",
		badge: "TOP 3",
	},
	{
		name: "星岛梦 (TOP 4)",
		url: "/posts/brand-xingdaomeng-review/",
		icon: "material-symbols:auto-awesome-rounded",
		badge: "TOP 4",
	},
	{
		name: "唯兔云 (TOP 5)",
		url: "/posts/brand-weitu-review/",
		icon: "material-symbols:hub-rounded",
		badge: "TOP 5 月付",
	},
];

const faqs = [
	{
		question: "2026 年挑选稳定靠谱的机场有哪些核心标准？",
		answer:
			"首选运营时间超过 3 年的老牌服务商（如 2020 年至今的光速云、星岛梦）；其次确认是否具备纯正 IEPL 企业专线，严防普通公网直连；再次看协议是否支持 VLESS，最后新手应严守月付或低单价年付原则。",
	},
	{
		question: "年付折算价格与真实月付价格有什么区别？",
		answer:
			"年付折算价（如光速云折合约 7.5 元/月、飞猫云 7 元/月）是通过一次性付清年费平摊计算的月成本；而真实月付（如宇宙云 14.9 元/月、二猫云 20 元/月）则支持单月充值，无需长期资金绑定。",
	},
];
---

<CategoryLanding
  title="2026精选机场推荐与稳定性排行榜 - Airportizi"
  description="2026年最新科学上网梯子机场推荐与权威排行榜。基于多省市千兆宽带全天24小时网络探针监测，横向评测晚高峰延迟、丢包率、4K超清秒开速度与性价比，首推5年老牌光速云。"
  h1Title="2026 科学上网机场推荐与权威排行榜"
  badge="权威推荐与评测"
  iconName="material-symbols:recommend-rounded"
  introMarkdown="挑选机场最怕‘晚高峰卡成幻灯片’和‘商家卷款失联跑路’。Airportizi 实验室在全国多节点部署探针，严格区分【年付折算低价】与【真实灵活月付】，从物理专线质量、VLESS 协议吞吐、AI/流媒体解锁到客服 SLA 展开 360 度实测打分，为您呈现最具公信力的 2026 机场榜单。"
  subLinks={subLinks}
  posts={jichangPosts}
  canonicalPath="/jichang/"
  faqs={faqs}
/>
